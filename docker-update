#!/usr/bin/env bash

set -eo pipefail

source "$HOME/.secrets"
PATH="$HOME/bin:${PATH}"
NTFY_URL="$DOCKER_UPDATER_NTFY_URL"
BASEDIR="$DOCKER_UPDATER_BASEDIR"

exclusions=(
    ARCHIVE
)

auto_update_list=(
    copyparty
)


has_update() { [[ -z "$(printf '%s\n' "${@}" | sort | uniq -d)" ]]; }

err() { [[ 0 != "$1" ]]; }

main() {
    local d
    walk -d 0 "$BASEDIR" \
        | sor 'test -d' \
        | grep -vE "${exclusions[*]}" \
        | while read -r d; do
            local ids=()
            pushd "$d" >/dev/null
            ids="$(docker compose images -q)"
            docker compose pull 2>/dev/null
            if err "$?"; then
                echo "error" >&2
                popd >/dev/null
                continue
            fi

            ids+=( "$(docker compose images -q)" )
            if ! has_update "${ids[@]}"; then
                #echo "$(pwd) no new image"
                popd >/dev/null
                continue
            fi

            curl -d "$d has update" "$DOCKER_UPDATER_NTFY_URL"

            for project in "${auto_update_list[@]}"; do
                if [[ "$project_name" == "$d" ]]; then
                    docker compose up -d
                    curl -d "$d was auto updated" "$DOCKER_UPDATER_NTFY_URL"
                    popd >/dev/null
                    continue
                fi
            done
            popd >/dev/null
        done

}; main "$@"
