#!/usr/bin/env bash

set -eo pipefail

exclude=(
    ARCHIVE
    cavegame-mc-server
    copyparty-music-upload
    filesharing
    headscale
    inspircd
    journal_publisher
    miyo-mc-server
    music-streaming
    noteDiscovery
    silverbullet
    silverbullet-readonly
    soju
    storage
    swingmusic
    tailscale-client
    vanilla-mc-server
    monitoring
)

basedir='/home/ubuntu/artix-server'

main() {
    local d
    walk -d 0 "$basedir" \
        | sor 'test -d' \
        | grep -vE "${exclude[*]}" \
        | while read -r d; do
            pushd "$d"
            docker compose pull
            docker compose up -d
            popd
        done

}; main "$@"
